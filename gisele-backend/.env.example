# GISELE backend — variaveis para o modo CENTRAL (produção).
# Copie para .env e ajuste antes de subir docker-compose.prod.yml.
# JAMAIS commite o .env real.

# Tag das imagens (em registry interno do CPTEC)
TAG=2.6.0

# PostgreSQL
POSTGRES_PASSWORD=__CHANGE_ME__

# MinIO (S3-compatible object store)
MINIO_ACCESS_KEY=gisele-prod
MINIO_SECRET_KEY=__CHANGE_ME__

# JWT secret para auth via OAuth CPTEC
JWT_SECRET=__CHANGE_ME_32_BYTES_RANDOM__
