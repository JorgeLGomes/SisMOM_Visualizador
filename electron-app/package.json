{
  "name": "sismom-visualizador",
  "version": "1.0.0",
  "description": "SisMOM - Visualizador de modelos meteorologicos (CPTEC/INPE)",
  "main": "main.js",
  "homepage": "https://",
  "author": {
    "name": "Jorge Luis Gomes",
    "email": "jorge.gomes@inpe.br"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -wl"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "br.gov.inpe.cptec.sismom",
    "productName": "SisMOM Visualizador",
    "files": [
      "main.js",
      "figuras_SisMOM_v23.html",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SisMOM Visualizador"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "category": "Science",
      "synopsis": "Visualizador de modelos meteorologicos SisMOM",
      "maintainer": "Jorge Luis Gomes <jorge.gomes@inpe.br>",
      "desktop": {
        "entry": {
          "Name": "SisMOM Visualizador",
          "Comment": "Visualizador de modelos do SisMOM (CPTEC/INPE)"
        }
      }
    }
  }
}
