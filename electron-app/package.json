{
  "name": "gisele",
  "version": "2.8.0",
  "description": "GISELE - Gestao Integrada de Solucoes Estrategicas e Inteligencia (CPTEC/INPE)",
  "main": "main.js",
  "homepage": "https://",
  "author": {
    "name": "Jorge Luis Gomes",
    "email": "jorge.gomes@inpe.br"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "clean": "node -e \"const fs=require('fs');try{fs.rmSync('dist',{recursive:true,force:true});console.log('dist limpo');}catch(e){}\"",
    "prebuild": "npm run clean",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -wlm",
    "dist:standalone": "node scripts/build-standalone.js",
    "postdist": "npm run dist:standalone",
    "postdist:win": "npm run dist:standalone",
    "postdist:linux": "npm run dist:standalone",
    "postdist:mac": "npm run dist:standalone",
    "postdist:all": "npm run dist:standalone"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "br.gov.inpe.cptec.gisele",
    "productName": "GISELE",
    "files": [
      "main.js",
      "preload.js",
      "python-spawner.js",
      "figuras_SisMOM_v23.html",
      "manifest.webmanifest",
      "icon.ico",
      "icon.png",
      "sismom-icon-192.png",
      "sismom-icon-512.png"
    ],
    "extraResources": [
      {
        "from": "python-helper/dist",
        "to": "python-helper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GISELE"
    },
    "portable": {
      "artifactName": "GISELE-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Science",
      "synopsis": "GISELE - visualizador de modelos meteorologicos (CPTEC/INPE)",
      "maintainer": "Jorge Luis Gomes <jorge.gomes@inpe.br>",
      "desktop": {
        "entry": {
          "Name": "GISELE",
          "Comment": "GISELE - Gestao Integrada de Solucoes Estrategicas e Inteligencia (CPTEC/INPE)"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "GISELE",
        "NSHumanReadableCopyright": "(c) CPTEC/INPE 2026"
      }
    },
    "dmg": {
      "title": "GISELE ${version}",
      "artifactName": "GISELE-${version}-${arch}.dmg"
    },
    "directories": {
      "output": "dist"
    }
  }
}
